{
    "name": "@christtrade/depth",
    "version": "0.12.22",
    "description": "Depth - the charting library built for ChristTrade.",
    "author": "ChristTrade",
    "license": "Apache-2.0",
    "homepage": "https://christtrade.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/christtrade/depth.git"
    },
    "private": true,
    "main": "./src/core/index.ts",
    "types": "./src/core/index.ts",
    "exports": {
        ".": "./src/core/index.ts",
        "./react": "./src/ChartOuter.tsx"
    },
    "scripts": {
        "dist": "npm run dist:js && npm run dist:types && npm run dist:css && npm run dist:smoke",
        "dist:smoke": "node build/smoke.mjs",
        "dist:slim": "SLIM=1 npm run dist:js && npm run dist:types && npm run dist:css && npm run dist:smoke",
        "dist:js": "node build/build.mjs",
        "dist:types": "tsc -p tsconfig.json --declaration --emitDeclarationOnly --noEmit false --incremental false --outDir dist/types",
        "dist:css": "tailwindcss -c build/tailwind.dist.config.cjs -i build/tailwind.entry.css -o dist/depth.css --minify && PREFLIGHT=0 tailwindcss -c build/tailwind.dist.config.cjs -i build/tailwind.entry.css -o dist/depth.nopreflight.css --minify && node build/inline-fonts.mjs",
        "dist:pack": "cd dist && npm pack --pack-destination ..",
        "test": "tsx --test \"src/**/*.test.ts\""
    },
    "peerDependencies": {
        "react": "^18",
        "react-dom": "^18"
    },
    "dependencies": {
        "nanoid": "^5.1.6",
        "sonner": "^2.0.6",
        "luxon": "^3.6.1",
        "lucide-react": "^0.536.0",
        "clsx": "^2.1.1",
        "tailwind-merge": "^2.6.0",
        "class-variance-authority": "^0.7.1",
        "react-colorful": "^5.6.1",
        "react-resizable-panels": "^2.1.9",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-hover-card": "^1.1.6",
        "@radix-ui/react-popover": "^1.1.4",
        "@radix-ui/react-separator": "^1.1.1",
        "@radix-ui/react-slider": "^1.2.3",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tooltip": "^1.1.6"
    },
    "devDependencies": {
        "@types/node": "^20.19.37",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "esbuild": "^0.28.1",
        "jsdom": "^26.1.0",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
